<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoSystem.Client.Views.LoginPage"
             Title="EcoSystem Connect">
    <Grid Padding="24" RowDefinitions="*,Auto,*">
        <VerticalStackLayout Grid.Row="1" Spacing="16" MaximumWidthRequest="420">
            <Label Text="EcoSystem Connect" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Inicia sesion para administrar productos" HorizontalOptions="Center" />
            <Entry Placeholder="Usuario" Text="{Binding Username}" ReturnType="Next" />
            <Entry Placeholder="Contrasena" Text="{Binding Password}" IsPassword="True" ReturnType="Go" />
            <Button Text="Iniciar sesion" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
            <Label Text="{Binding SuccessMessage}" TextColor="Green" IsVisible="{Binding SuccessMessage, Converter={StaticResource StringNotEmptyConverter}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
