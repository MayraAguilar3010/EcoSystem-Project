<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoSystem.Client.Views.ProductoFormPage"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="520">
            <Label Text="{Binding Title}" FontSize="28" FontAttributes="Bold" />
            <Entry Placeholder="Nombre" Text="{Binding Nombre}" />
            <Entry Placeholder="Precio" Keyboard="Numeric" Text="{Binding Precio}" />
            <Entry Placeholder="Existencias" Keyboard="Numeric" Text="{Binding Stock}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Cancelar" Command="{Binding CancelCommand}" BackgroundColor="#5F6368" />
                <Button Grid.Column="1" Text="Guardar" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            </Grid>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
            <Label Text="{Binding SuccessMessage}" TextColor="Green" IsVisible="{Binding SuccessMessage, Converter={StaticResource StringNotEmptyConverter}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
